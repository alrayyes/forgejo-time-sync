# Copy to .env and fill in. See README.md for what each of these means.

FORGEJO_BASE_URL=https://forgejo.example.com
FORGEJO_TOKEN=
FORGEJO_OWNER=
FORGEJO_REPO=

TOGGL_API_TOKEN=
TOGGL_WORKSPACE_ID=

# Optional — defaults shown.
# TOGGL_PROJECT_ID=              # unset: auto-creates a client named
                                  # FORGEJO_OWNER and a project named
                                  # FORGEJO_REPO under it, first run only
# SYNC_INTERVAL_SECONDS=10
# STATE_FILE_PATH=/data/state.json
# TOGGL_MAX_REQUESTS_PER_HOUR=30
