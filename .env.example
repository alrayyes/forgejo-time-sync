# Copy to .env and fill in. See README.md for what each of these means.
#
# Running via compose.yaml: leave FORGEJO_TOKEN and TOGGL_API_TOKEN blank
# here and put the real values in secrets/forgejo_token and
# secrets/toggl_api_token instead — compose.yaml wires those in as Docker
# Compose secrets, which don't end up readable in `docker inspect` or logs
# the way a plain env var does. Running the image directly with `docker
# run --env-file .env` (no Compose, no secrets: mount) is the one case
# that still needs them filled in here.

FORGEJO_BASE_URL=https://forgejo.example.com
FORGEJO_TOKEN=
FORGEJO_OWNER=
FORGEJO_REPO=

TOGGL_API_TOKEN=
TOGGL_ORGANIZATION_ID=
TOGGL_WORKSPACE_ID=

# Optional — defaults shown.
# TOGGL_PROJECT_ID=              # unset: auto-creates a client named
                                  # FORGEJO_OWNER and a project named
                                  # FORGEJO_REPO under it, first run only
# SYNC_INTERVAL_SECONDS=10
# STATE_FILE_PATH=/data/state.json
# TOGGL_MAX_REQUESTS_PER_HOUR=30
